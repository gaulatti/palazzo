# Palazzo — environment variables
# Copy this file to .env and adjust values before running.

# HTTP API server port.
PALAZZO_PORT=3100

# One Palazzo instance owns one Alcantara radio-capable program.
PROGRAM_ID=program-local
RADIO_FILLER_STORE_DIR=/var/lib/palazzo/fillers
PALAZZO_INSTANCE_ID=palazzo-local

# PALAZZO_BUILD_VERSION is injected into the image by CI. Local image builds
# expose the bounded value "development"; do not put credentials in build args.

# Maximum wait for Start readiness or Stop idle confirmation.
LIFECYCLE_TRANSITION_TIMEOUT_MS=5000

# Ahead-of-air media probing. Values are clamped to documented safe bounds.
PREFLIGHT_LOOKAHEAD_SECONDS=900
PREFLIGHT_BATCH_SIZE=20
PREFLIGHT_CONCURRENCY=2
PREFLIGHT_CACHE_ENTRIES=128
PREFLIGHT_TTL_SECONDS=300
PREFLIGHT_TIMEOUT_MS=10000

# Durable sequence-range reservation. Keep this on Palazzo's persistent volume.
PLAYBACK_EVENT_SEQUENCE_PATH=/var/lib/palazzo/fillers/playback-event-sequence.json

# Comma-separated list of allowed CORS origins.
# localhost / 127.0.0.1 origins are always allowed automatically.
ALLOWED_ORIGINS=http://localhost:5173

# Icecast source-password used by Liquidsoap to authenticate to Icecast.
ICECAST_SOURCE_PASSWORD=palazzo-source

# Icecast streaming port (inside the container).
ICECAST_PORT=8000

# Icecast mount point for the stream (e.g. /stream, /radio).
ICECAST_MOUNT=/stream

# Public stream metadata displayed in listener clients.
STREAM_NAME=Palazzo
STREAM_GENRE=Various

# MP3 output bitrate in kbps.
BITRATE=128

# Optional RTMP live input URL (e.g. rtmp://example.com/live/stream).
# Leave unset to disable the live input source.
# RTMP_URL=

# --- The following variables are reserved for future multi-stream
# --- functionality and are NOT used by the current codebase.

# DOCKER_SOCKET_PATH=/var/run/docker.sock
# STREAM_IMAGE=palazzo-stream
# STREAMS_WORKDIR=/tmp/palazzo-streams
# TELNET_PORT_START=14000
# TELNET_PORT_END=14999
# ICECAST_HOST=host.docker.internal
# ICECAST_ADMIN_PASSWORD=palazzo-admin
# ICECAST_RELAY_PASSWORD=palazzo-relay
